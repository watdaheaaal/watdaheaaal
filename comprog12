// Import necessary Swing and AWT classes
import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionListener;
import java.awt.event.ActionEvent;

public class MyCalculator extends JFrame {
    String myDisplay = "";
    String operator = "";
    double firstNum = 0;
    double secondNum = 0;
    boolean isOperatorClicked = false;
    JTextField textfield = new JTextField(20);

    // ButtonActionHandler to handle button presses
    public class ButtonActionHandler implements ActionListener {
        public void actionPerformed(ActionEvent e) {
            String command = e.getActionCommand();

            // Handle number buttons
            if (command.charAt(0) >= '0' && command.charAt(0) <= '9') {
                if (isOperatorClicked) {
                    myDisplay = ""; // Clear display for new number input
                    isOperatorClicked = false;
                }
                myDisplay += command; // Append the number to the display
                textfield.setText(myDisplay);
            } 
            // Handle operator buttons
            else if (command.equals("+") || command.equals("-") || command.equals("*") || command.equals("/") || command.equals("%")) {
                if (!myDisplay.isEmpty()) {
                    firstNum = Double.parseDouble(myDisplay); // Store the first number
                    operator = command; // Set the operator
                    isOperatorClicked = true; // Indicate that an operator has been clicked
                }
            } 
            // Handle equal button
            else if (command.equals("=")) {
                if (!myDisplay.isEmpty() && operator != null) {
                    secondNum = Double.parseDouble(myDisplay); // Store the second number
                    switch (operator) {
                        case "+":
                            myDisplay = String.valueOf(firstNum + secondNum);
                            break;
                        case "-":
                            myDisplay = String.valueOf(firstNum - secondNum);
                            break;
                        case "*":
                            myDisplay = String.valueOf(firstNum * secondNum);
                            break;
                        case "/":
                            if (secondNum != 0) {
                                myDisplay = String.valueOf(firstNum / secondNum);
                            } else {
                                myDisplay = "Error";
                            }
                            break;
                        case "%":
                            myDisplay = String.valueOf(firstNum % secondNum);
                            break;
                    }
                    textfield.setText(myDisplay);
                    operator = null; // Reset operator after calculation
                }
            } 
            // Handle clear button
            else if (command.equals("C")) {
                myDisplay = "";
                firstNum = 0;
                secondNum = 0;
                operator = "";
                textfield.setText(myDisplay);
            }
        }
    }

